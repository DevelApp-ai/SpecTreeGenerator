<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="github" value="https://nuget.pkg.github.com/DevelApp-ai/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <!--
    Package source mapping (NuGet 6.0+): the GitHub Packages feed serves only
    DevelApp packages. Everything else is resolved from nuget.org. Without the
    mapping, NuGet queries the GitHub feed for every package id and its 403
    response for packages it does not serve fails the restore (NU1301).
  -->
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="DevelApp.Minotaur" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
