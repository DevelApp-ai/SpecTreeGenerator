<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CodeAnalysis.Abstractions\SpecTreeGenerator.CodeAnalysis.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DevelApp.StepParser" Version="1.32.0" />
  </ItemGroup>

  <!-- ICU4N (transitive via StepParser) emits ICU4N_IDE_0002 when its
       buildTransitive target cannot detect the packing tasks DLL in the
       current SDK; the check is advisory and unrelated to this project's
       output. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);ICU4N_IDE_0002</NoWarn>
  </PropertyGroup>

</Project>
