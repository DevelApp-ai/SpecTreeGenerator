# Auto-detect text files and normalize line endings to LF in the repo.
* text=auto

# Source code: force LF on checkout to keep Linux/Windows consistent.
*.cs text diff=csharp eol=lf
*.csproj text eol=lf
*.sln text eol=crlf
*.props text eol=lf
*.targets text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.editorconfig text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary files: never touch line endings
*.pdf binary
*.docx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dll binary
*.exe binary
